{
  "manifest_version": 3,
  "name": "More Settings for Firefox",
  "version": "1.0.0",
  "description": "Privacy extras Firefox and uBlock Origin don't have: clean tracking out of links (and see when it happens), remove pop-ups per site, pretend to be Chrome, hidden privacy settings, Alt+Shift+D duplicate tab.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "action": {
    "default_icon": "icon.svg",
    "default_popup": "popup.html",
    "default_title": "More Settings for Firefox"
  },
  "background": {
    "scripts": [
      "settings.js",
      "lib/links.js",
      "background.js"
    ]
  },
  "commands": {
    "duplicate-tab": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Duplicate the current tab"
    }
  },
  "permissions": [
    "storage",
    "privacy",
    "scripting",
    "declarativeNetRequestWithHostAccess",
    "webRequest",
    "webRequestBlocking",
    "menus",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "more-settings-for-firefox@timwjt",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
